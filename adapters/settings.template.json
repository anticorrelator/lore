{
  "version": 2,
  "tui_launch_framework": "claude-code",
  "routes": {
    "lead": "claude-code/opus",
    "worker": "claude-code/opus",
    "worker-mechanical": "claude-code/opus",
    "worker-judgment-dense": "claude-code/opus",
    "researcher": "claude-code/opus",
    "reviewer": "claude-code/opus",
    "advisor": "claude-code/opus",
    "default": "claude-code/opus"
  },
  "harnesses": {
    "claude-code": {
      "args": ["--dangerously-skip-permissions"],
      "native_models": {"default": "opus"}
    },
    "opencode": {
      "args": [],
      "native_models": {"default": "anthropic/opus"}
    },
    "codex": {
      "args": [],
      "native_models": {"default": "gpt-5.5-high"}
    }
  },
  "capability_overrides": {},
  "tui": {
    "layout": "left-right"
  },
  "obsidian": {
    "vaults": {}
  },
  "coordination": {
    "max_concurrency": 1,
    "session_request_ttl_seconds": 3600
  },
  "retro_sampling": {
    "routine_rate": 0.25
  },
  "conformance_sampling": {
    "render_rate": 0.25
  }
}
